NODE_ENV='production'
VITE_APP_TITLE=用户认证授权服务
VITE_APP_COPY_RIGHT=慕课网实战 Spring Security 课程
VITE_APP_API_URL=
VITE_APP_OAUTH_AUTH_URL=/oauth/authorize?response_type=code&client_id=admin-client&redirect_uri=http://localhost:8080
VITE_APP_OAUTH_TOKEN_URL=/oauth/token
VITE_APP_OAUTH_REDIRECT_URI=http://localhost:8080
VITE_APP_OAUTH_CLIENT_ID=admin-client
VITE_APP_OAUTH_CLIENT_SECRET=secret